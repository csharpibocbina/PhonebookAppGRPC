# Copy to .env and change the values: cp .env.example .env
POSTGRES_DB=phonebook
POSTGRES_USER=phonebook
POSTGRES_PASSWORD=change-me-please

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SIGNING_KEY=replace-with-a-long-random-secret-at-least-32-chars

# "true" once the app is served over HTTPS.
REFRESH_COOKIE_SECURE=false
