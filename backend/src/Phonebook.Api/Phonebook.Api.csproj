<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <ProjectReference Include="..\Phonebook.Infrastructure\Phonebook.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.AspNetCore.Web" />
    <PackageReference Include="Grpc.AspNetCore.Server.Reflection" />
    <PackageReference Include="Grpc.AspNetCore.HealthChecks" />
    <PackageReference Include="Microsoft.AspNetCore.Grpc.JsonTranscoding" />
    <PackageReference Include="Microsoft.AspNetCore.Grpc.Swagger" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Grpc.Tools turns each .proto into C# at build time.
      GrpcServices="Both" generates the abstract *Base classes we override (server)
      and typed *Client classes (the integration tests use them to call the server).
      The shared /proto folder is the contract used by both backend and frontend.
    -->
    <Protobuf Include="..\..\..\proto\auth\v1\auth.proto" ProtoRoot="..\..\..\proto" GrpcServices="Both" Link="Protos\auth.proto" />
    <Protobuf Include="..\..\..\proto\phonebook\v1\phonebook.proto" ProtoRoot="..\..\..\proto" GrpcServices="Both" Link="Protos\phonebook.proto" />
  </ItemGroup>
  <PropertyGroup>
    <!-- Lets Swashbuckle include the proto comments in the OpenAPI document. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Phonebook.UnitTests" />
  </ItemGroup>
</Project>
