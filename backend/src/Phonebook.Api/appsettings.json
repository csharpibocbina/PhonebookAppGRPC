{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://0.0.0.0:8081",
        "Protocols": "Http2"
      }
    }
  },
  "ConnectionStrings": {
    "Phonebook": "Data Source=phonebook.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "SeedDemoData": true
  },
  "Jwt": {
    "Issuer": "phonebook-api",
    "Audience": "phonebook-web",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "RefreshCookieSecure": true
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 2525,
    "From": "no-reply@phonebook.local",
    "FromName": "Phonebook",
    "Enabled": true
  },
  "RateLimiting": {
    "AuthPermitLimit": 20
  },
  "ApiDocs": {
    "Enabled": true
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  }
}
